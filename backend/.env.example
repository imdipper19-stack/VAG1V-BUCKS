# =====================================================================
# Bag1V-Bucks backend — example env. Скопируй в .env и заполни секреты.
# =====================================================================

# ───── Backend ─────
PORT=3001
NODE_ENV=development
BASE_URL=http://localhost:3002

# ───── Database (Postgres) ─────
# При локальной разработке (backend вне Docker) — порт 5433 (docker-compose mapping).
# При запуске backend внутри Docker — host=postgres, port=5432 (см. docker-compose.yml).
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=bag1vbucks
DB_SYNCHRONIZE=true
DB_LOGGING=false

# ───── Redis (BullMQ) ─────
REDIS_HOST=localhost
REDIS_PORT=6379

# ───── API Purchase (новый быстрый flow ~50 сек / заказ) ─────
# Параллельных заказов в очереди. На VPS 4 vCPU / 8 GB безопасно 3.
ORDER_CONCURRENCY=3

# Headless-режим Chromium. true для production (нет X-сервера в Docker).
# false для локальной отладки чтобы видеть Cloudflare-challenges.
API_PURCHASE_HEADLESS=true

# ───── Razer Gold (опционально, для админки) ─────
# Используется только в RazerAccountController.validateRazerCookies.
# Сами заказы используют credentials из RazerAccount entity, не отсюда.
RAZER_USERNAME=
RAZER_PASSWORD=

# ───── AntiLav payment gateway ─────
ANTILAV_API_KEY=your-antilav-api-key
ANTILAV_SHOP_ID=your-antilav-shop-id

# ───── JWT ─────
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-random-32-byte-hex
JWT_EXPIRES_IN=24h

# ───── Webhook HMAC ─────
WEBHOOK_SECRET=change-me-to-random-hex

# ───── Default admin (создаётся при первом запуске) ─────
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_EMAIL=admin@bag1vbucks.local
ADMIN_DEFAULT_PASSWORD=change-me

# ───── Telegram нотификации (опционально) ─────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ───── Legacy Epic OAuth (старый submit-code путь, опционально) ─────
# Новый device flow использует публичные credentials Switch-клиента,
# зашитые в epic-auth.service.ts. Эти переменные нужны только если
# хочешь оставить /api/auth/submit-code endpoint работающим.
# Можно оставить пустыми — submit-code просто перестанет работать,
# но новый /api/auth/device/start + /poll будет работать.
EPIC_CLIENT_ID=
EPIC_CLIENT_SECRET=

# ───── Legacy Playwright (только для validateRazerCookies в админке) ─────
BROWSER_HEADLESS=true
