# Backend
PORT=3001
NODE_ENV=development
BASE_URL=http://localhost:3002

# Database (имена должны совпадать с backend/src/database/database.module.ts)
# При локальной разработке (backend вне docker) — порт 5433 (docker-compose маппинг)
# При запуске backend внутри docker — порт 5432 и host=postgres
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=bag1vbucks
DB_SYNCHRONIZE=true
DB_LOGGING=false

# Redis (BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# Epic Games API (https://dev.epicgames.com)
EPIC_CLIENT_ID=your-epic-client-id
EPIC_CLIENT_SECRET=your-epic-client-secret

# Razer Gold (https://gold.razer.com)
RAZER_USERNAME=your-razer-username
RAZER_PASSWORD=your-razer-password

# AntiLav payment gateway
ANTILAV_API_KEY=your-antilav-api-key
ANTILAV_SHOP_ID=your-antilav-shop-id

# JWT (сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change-me-to-random-32-byte-hex
JWT_EXPIRES_IN=24h

# Webhook HMAC секрет
WEBHOOK_SECRET=change-me-to-random-hex

# Default admin (создаётся при первом запуске)
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_EMAIL=admin@bag1vbucks.local
ADMIN_DEFAULT_PASSWORD=change-me

# Telegram нотификации (опционально)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Playwright
BROWSER_HEADLESS=true

# Frontend (для CORS / SSR)
NEXT_PUBLIC_API_URL=http://localhost:3001/api
